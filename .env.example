# copy to .env and fill in real values
NODE_ENV=development
PORT=3000
DB_PATH=./data/taskflow.db

# REQUIRED in production - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Comma separated allowed origins, e.g. https://app.example.com
# REQUIRED in production (fails fast if missing)
CORS_ORIGIN=

# Set true ONLY behind a reverse proxy (nginx/cloudflare). Keep false when
# the server is exposed directly so X-Forwarded-For cannot be spoofed to bypass rate limits.
TRUST_PROXY=false

# combined | dev
LOG_LEVEL=dev